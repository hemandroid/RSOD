# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# The backend reads this file. The Flutter app reads NOTHING here except INGEST_APP_TOKEN.
# Any key left empty disables its integration with a loud startup failure, never a silent default.
# Step-by-step instructions for obtaining each value: docs/INPUTS_REQUIRED.md

# --- CORE. The objective depends on these two blocks. ---
# https://id.atlassian.com/manage-profile/security/api-tokens (scoped token, write:jira-work)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Scoped API tokens do NOT work against https://<site>.atlassian.net — they return 401
# AUTHENTICATED_FAILED. They must go through Atlassian's gateway, which needs the cloud id:
#   curl -s "$JIRA_BASE_URL/_edge/tenant_info"   (public, no auth)
# JIRA_BASE_URL stays for building human-clickable links in the Slack message.
JIRA_CLOUD_ID=
JIRA_API_BASE=https://api.atlassian.com/ex/jira

# https://api.slack.com/apps -> OAuth & Permissions -> chat:write + chat:write.public
# Bot token starts xoxb-. Channel id starts C, user id starts U.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_DM_USER_ID=

# --- CORE. Analysis runs between capture and the ticket. ---
# Any provider with a free tier; swaps later behind IncidentAnalyzer. Groq verified 20 Sep 2026.
# Model ids are retired often — never hardcode one. List what your key can reach with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $AI_API_KEY"
AI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
# Azure AI Foundry uses an api-key header instead of Bearer, names the model in the URL,
# and needs an api-version. Left blank until Kamal provisions it; the analyser reads these
# rather than branching on a provider name.
AI_AUTH_HEADER=Authorization
AI_API_VERSION=

# --- Backend ---
# Cloudflare Workers deploy URL. Until it exists, develop against the local sink.
BACKEND_PUBLIC_URL=
# openssl rand -hex 32 — the one secret the app carries, passed via --dart-define.
INGEST_APP_TOKEN=

# --- Optional, later ---
# Release signing. NOT needed for the demo: phase 1 ran a release build on the emulator
# with debug signing and captured all six failures.
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# Session replay link on the ticket. A nice beat, not core.
CLARITY_PROJECT_ID=

# Absolute: the server runs from backend/, so a relative path would resolve there.
# The build must write --split-debug-info into <SYMBOLS_DIR>/<commit-sha>/ so a trace
# can be matched to the build that produced it.
SYMBOLS_DIR=/absolute/path/to/repo/build/symbols
