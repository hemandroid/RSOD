# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# The backend reads this file. The Flutter app reads NONE of it except INGEST_APP_TOKEN.
# Any key left empty disables its integration with a loud startup warning.

# --- Day 1: Android release signing (see android/key.properties) ---
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# --- Day 2: backend (Appwrite) ---
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
BACKEND_PUBLIC_URL=
# openssl rand -hex 32
INGEST_APP_TOKEN=

# --- Day 1-2: CORE. The objective depends on these. ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_DM_USER_ID=

# --- Day 2-3: CORE. Analysis runs before the ticket is filed. ---
# Any provider with a working free tier unblocks day 3; swaps later behind IncidentAnalyzer.
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=

# --- Day 5 or later: optional ---
# GitHub Copilot SDK. Needs a paid plan (bills AI credits), so not a 5-day dependency.
COPILOT_TOKEN=

CLARITY_PROJECT_ID=
