# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
# The service that files the Jira ticket and posts to Slack now lives in its
# own repository: ../../../FlutterCon_2026/incident-backend. Its Jira, Slack
# and model credentials belong in that repo's .env.local, or in the Render
# dashboard — not here. This file holds only what the Flutter app needs.
#
# The app itself reads nothing from this file at runtime. Values here are the
# source for dart_defines.local.json and dart_defines.cloud.json, which are
# gitignored and passed with --dart-define-from-file. See dart_defines.example.json.

# The one secret the app carries. Must match INGEST_APP_TOKEN in the backend's
# own environment, or every upload comes back 401.
#   openssl rand -hex 32
INGEST_APP_TOKEN=

# Where the app ships incidents. Empty until the backend is deployed; against a
# laptop backend the emulator reaches it at http://10.0.2.2:8787/ingest.
BACKEND_PUBLIC_URL=

# --- Optional, later ---
# Release signing. NOT needed for the demo: phase 1 ran a release build on the
# emulator with debug signing and captured all six failures.
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# Session replay link on the ticket. A nice beat, not core.
CLARITY_PROJECT_ID=
